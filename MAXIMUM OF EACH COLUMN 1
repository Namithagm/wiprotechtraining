import java.io.*;
import java.util.*;
import java.text.*;
import java.math.*;
import java.util.regex.*;

public class Solution {

    public static void main(String[] args) {
        /* Enter your code here. Read input from STDIN. Print output to STDOUT. Your class should be named Solution. */
       Scanner sc=new Scanner(System.in);
       int m=sc.nextInt();
       int n=sc.nextInt();
       int nums[][]=new int[m][n];
       for(int i=0;i<m;i++){
           for(int j=0;j<n;j++){
               nums[i][j]=sc.nextInt();
           }
       }
        
    for(int j=0;j<n;j++){
        int max=nums[0][j];
        for(int i=0;i<m;i++){
         if(max<nums[i][j]){
            max=nums[i][j];
        } 
            
        }
        int n1=j+1;
        System.out.println("Maximum value in column "+n1+" is "+max);
        
    }
    
    
    
    }
}
